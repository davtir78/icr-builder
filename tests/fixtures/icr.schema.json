{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:icr-builder:schema:icr:0.2",
  "title": "Integration Contract Record front matter (v0.2, DRAFT)",
  "type": "object",
  "required": ["icr", "id", "title", "status", "version", "date", "pattern", "interaction", "provider", "consumers", "interfaces", "data"],
  "additionalProperties": false,
  "properties": {
    "icr": { "type": "string", "const": "0.2", "description": "ICR specification version this record follows." },
    "id": { "type": "string", "pattern": "^ICR-[0-9A-Za-z-]+$" },
    "title": { "type": "string", "minLength": 3 },
    "status": { "enum": ["draft", "proposed", "agreed", "active", "deprecated", "retired"] },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$", "description": "Semantic version of this contract." },
    "date": { "type": "string", "format": "date" },
    "pattern": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": { "id": { "type": "string" }, "url": { "type": "string", "format": "uri" } }
    },
    "interaction": { "enum": ["sync-request-response", "async-event", "async-message", "stream", "batch-file"] },
    "provider": { "$ref": "#/$defs/party" },
    "consumers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/party" } },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "ref"],
        "additionalProperties": false,
        "properties": {
          "type": { "enum": ["openapi", "asyncapi", "odcs", "cloudevents", "wsdl", "json-schema", "other"] },
          "ref": { "type": "string", "minLength": 1 },
          "version": { "type": "string" }
        }
      }
    },
    "data": {
      "type": "object",
      "required": ["classification", "personal-information"],
      "additionalProperties": false,
      "properties": {
        "classification": { "type": "string", "minLength": 1 },
        "personal-information": { "type": "boolean" }
      }
    },
    "decisions": { "type": "array", "items": { "type": "string" } },
    "supersedes": { "type": ["string", "null"] },
    "review-by": { "type": "string", "format": "date" }
  },
  "$defs": {
    "party": {
      "type": "object",
      "required": ["system", "owner"],
      "additionalProperties": false,
      "properties": {
        "system": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "contact": { "type": "string" }
      }
    }
  }
}
